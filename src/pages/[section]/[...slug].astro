---
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import ObsidianCallout from '../../components/ObsidianCallout.astro';
import { getCollection } from 'astro:content';
import { getSectionConfig } from '../../config/sections';
import { getPostSlug } from '../../utils/slug';
import readingTime from 'reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: {
      section: post.data.section,
      slug: getPostSlug(post),
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const sectionConfig = getSectionConfig(post.data.section);
const readStats = readingTime(post.body);
const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={`${post.data.title} | Resus Docs`}
  description={post.data.description}
  image={post.data.coverImage}
  articleDate={post.data.date}
  section={sectionConfig?.name}
>
  <article data-pagefind-body class="relative pt-10 pb-20">
    <!-- Header Hero Banner -->
    <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-500 mb-6">
        <a href="/" class="hover:text-cyan-400 transition-colors">Home</a>
        <span>/</span>
        {sectionConfig && (
          <a href={`/${sectionConfig.slug}`} class="hover:text-cyan-400 transition-colors">
            {sectionConfig.name}
          </a>
        )}
        <span>/</span>
        <span class="text-slate-300 font-semibold truncate max-w-[200px]">{post.data.title}</span>
      </nav>

      <!-- Section Badge -->
      {sectionConfig && (
        <a
          href={`/${sectionConfig.slug}`}
          class={`inline-flex items-center px-3 py-1 rounded-md text-xs font-mono font-semibold border mb-4 ${sectionConfig.badgeColor}`}
        >
          {sectionConfig.name}
        </a>
      )}

      <!-- Post Title -->
      <h1 data-pagefind-meta="title" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-100 tracking-tight leading-tight mb-6">
        {post.data.title}
      </h1>

      <!-- Post Description -->
      <p class="text-lg text-slate-300 leading-relaxed font-sans mb-8">
        {post.data.description}
      </p>

      <!-- Metadata Author & Date Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 py-4 px-5 rounded-2xl bg-slate-900/80 border border-slate-800 text-xs font-mono text-slate-400">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center text-cyan-300 font-bold">
            {post.data.author.charAt(0)}
          </div>
          <div>
            <div class="text-slate-200 font-semibold">{post.data.author}</div>
            <div class="text-[11px] text-slate-500">Emergency Medicine Contributor</div>
          </div>
        </div>

        <div class="flex items-center gap-4 text-slate-400">
          <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
          <span>•</span>
          <span>{readStats.text}</span>
        </div>
      </div>
    </header>

    <!-- Main Content Body with TOC Sidebar Layout -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
        
        <!-- Table of Contents (Desktop Sticky Sidebar) -->
        <aside class="hidden lg:block lg:col-span-1 space-y-6">
          <div class="sticky top-24 p-5 rounded-2xl bg-slate-900/60 border border-slate-800/80">
            <h3 class="text-xs font-semibold text-slate-200 uppercase tracking-wider font-mono mb-4 flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
              </svg>
              Table of Contents
            </h3>
            
            <nav class="space-y-2 text-xs font-sans">
              {headings.filter(h => h.depth <= 3).map((h) => (
                <a
                  href={`#${h.slug}`}
                  class={`block hover:text-cyan-400 transition-colors text-slate-400 ${
                    h.depth === 2 ? 'font-medium text-slate-300 pl-0' : 'pl-3 text-slate-400'
                  }`}
                >
                  {h.text}
                </a>
              ))}
            </nav>

            <div class="mt-6 pt-4 border-t border-slate-800 text-[11px] font-mono text-slate-500">
              <span>Obsidian MDX Rendered</span>
            </div>
          </div>
        </aside>

        <!-- Article Content Column -->
        <div class="lg:col-span-3">
          <div class="prose prose-invert max-w-none prose-headings:scroll-mt-24 prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-slate-100 prose-p:leading-relaxed prose-p:text-slate-300 prose-li:text-slate-300 prose-strong:text-slate-100 prose-code:font-mono">
            <Content components={{ Img, ObsidianCallout }} />
          </div>

          <!-- Tags & Share Footer -->
          <div class="mt-12 pt-6 border-t border-slate-800 flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-mono text-slate-500 mr-2">Tags:</span>
              {post.data.tags.map((tag) => (
                <a
                  href={`/tags/${tag}`}
                  class="px-2.5 py-1 rounded bg-slate-900 hover:bg-cyan-500/20 text-slate-300 hover:text-cyan-300 border border-slate-800 text-xs font-mono transition-colors"
                >
                  #{tag}
                </a>
              ))}
            </div>

            {sectionConfig && (
              <a
                href={`/${sectionConfig.slug}`}
                class="text-xs font-mono text-cyan-400 hover:underline flex items-center gap-1"
              >
                <span>Back to {sectionConfig.name}</span>
                <span>→</span>
              </a>
            )}
          </div>
        </div>

      </div>
    </div>
  </article>
</Layout>
