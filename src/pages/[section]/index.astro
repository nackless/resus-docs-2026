---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { SECTIONS, getSectionConfig } from '../../config/sections';
import { getPostSlug } from '../../utils/slug';
import readingTime from 'reading-time';

export async function getStaticPaths() {
  return Object.keys(SECTIONS).map((sectionId) => ({
    params: { section: sectionId },
  }));
}

const { section } = Astro.params;
const sectionConfig = getSectionConfig(section!);

if (!sectionConfig) {
  return Astro.redirect('/404');
}

const allPosts = await getCollection('posts', ({ data }) => {
  return !data.draft && data.section === section;
});

const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Collect all unique tags for this section
const tagsMap = sortedPosts.reduce((acc, post) => {
  post.data.tags.forEach((tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const tagsList = Object.entries(tagsMap).sort((a, b) => b[1] - a[1]);
---

<Layout
  title={`${sectionConfig.name} | Resus Docs`}
  description={sectionConfig.description}
  section={sectionConfig.name}
>
  <!-- Section Header -->
  <section class={`relative pt-12 pb-16 bg-gradient-to-b ${sectionConfig.gradient} border-b border-slate-200/80 dark:border-slate-800/80 transition-colors duration-200`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400 mb-6">
        <a href="/" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-semibold">{sectionConfig.name}</span>
      </nav>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-3 max-w-3xl">
          <span class={`inline-flex items-center px-3 py-1 rounded-md text-xs font-mono font-semibold border ${sectionConfig.badgeColor}`}>
            {sectionConfig.name}
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
            {sectionConfig.name} Archive
          </h1>
          <p class="text-slate-600 dark:text-slate-300 text-base leading-relaxed font-sans">
            {sectionConfig.description}
          </p>
        </div>

        <div class="flex items-center gap-3 font-mono text-xs text-slate-600 dark:text-slate-400 bg-white/80 dark:bg-slate-900/80 px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm self-start md:self-auto">
          <span class="font-bold text-cyan-600 dark:text-cyan-400">{sortedPosts.length}</span>
          <span>Articles Published</span>
        </div>
      </div>

      <!-- Tag Filter Cloud -->
      {tagsList.length > 0 && (
        <div class="mt-8 pt-6 border-t border-slate-200/80 dark:border-slate-800/60 flex flex-wrap items-center gap-2">
          <span class="text-xs font-mono text-slate-500 dark:text-slate-400 mr-2">Filter by tag:</span>
          {tagsList.map(([tag, count]) => (
            <a
              href={`/tags/${tag}`}
              class="px-2.5 py-1 rounded-md text-xs font-mono bg-white dark:bg-slate-900 hover:bg-cyan-500/10 dark:hover:bg-cyan-500/20 text-slate-600 dark:text-slate-400 hover:text-cyan-700 dark:hover:text-cyan-300 border border-slate-200 dark:border-slate-800 hover:border-cyan-500/40 transition-colors flex items-center gap-1.5 shadow-xs"
            >
              <span>#{tag}</span>
              <span class="text-[10px] text-slate-400 dark:text-slate-500 font-bold">({count})</span>
            </a>
          ))}
        </div>
      )}

    </div>
  </section>

  <!-- Posts Grid -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {sortedPosts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            section={post.data.section}
            slug={getPostSlug(post)}
            tags={post.data.tags}
            readingTime={readingTime(post.body).text}
            coverImage={post.data.coverImage}
          />
        ))}
      </div>
    ) : (
      <div class="py-20 text-center space-y-4 bg-white/60 dark:bg-slate-900/40 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
        <p class="text-slate-600 dark:text-slate-400 font-mono text-sm">No clinical documents published in this section yet.</p>
        <a href="/" class="inline-block text-cyan-600 dark:text-cyan-400 font-mono text-xs hover:underline">Return to Homepage →</a>
      </div>
    )}
  </section>
</Layout>
