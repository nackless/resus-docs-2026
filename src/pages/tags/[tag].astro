---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import readingTime from 'reading-time';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => !data.draft);
  const tagsSet = new Set<string>();
  allPosts.forEach((post) => {
    post.data.tags.forEach((tag) => tagsSet.add(tag));
  });

  return Array.from(tagsSet).map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;
const allPosts = await getCollection('posts', ({ data }) => {
  return !data.draft && data.tags.includes(tag!);
});

const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title={`Tag: #${tag} | Resus Docs`}
  description={`Clinical articles and emergency medicine notes tagged with #${tag}.`}
>
  <section class="py-12 bg-slate-950 border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-500 mb-6">
        <a href="/" class="hover:text-cyan-400">Home</a>
        <span>/</span>
        <a href="/tags" class="hover:text-cyan-400">Tags</a>
        <span>/</span>
        <span class="text-slate-300 font-semibold">#{tag}</span>
      </nav>

      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-100 tracking-tight">
            Topic: <span class="text-cyan-400">#{tag}</span>
          </h1>
          <p class="text-slate-400 text-sm font-sans mt-2">
            Showing all clinical documents tagged with #{tag}.
          </p>
        </div>

        <div class="font-mono text-xs text-slate-400 bg-slate-900 px-3.5 py-2 rounded-xl border border-slate-800">
          <span class="font-bold text-cyan-400">{sortedPosts.length}</span> articles
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          section={post.data.section}
          slug={post.slug}
          tags={post.data.tags}
          readingTime={readingTime(post.body).text}
          coverImage={post.data.coverImage}
        />
      ))}
    </div>
  </section>
</Layout>
