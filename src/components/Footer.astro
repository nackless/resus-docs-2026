---
import Logo from './Logo.astro';
import { SECTIONS } from '../config/sections';
---

<footer class="mt-20 border-t border-slate-800/80 bg-slate-950/90 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Brand Column -->
      <div class="md:col-span-2 space-y-4">
        <Logo size="lg" showText={true} showTagline={true} />
        <p class="text-sm text-slate-400 max-w-md leading-relaxed">
          High-performance, evidence-based emergency medicine publishing engine. Engineered for clinical precision, rapid bedside reference, and seamless Obsidian MDX authoring.
        </p>
        <div class="flex items-center gap-4 text-xs text-slate-500 font-mono">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 rounded-md">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
            Cloudflare Edge Native
          </span>
          <span>Obsidian Sync Compatible</span>
        </div>
      </div>

      <!-- Navigation Column -->
      <div>
        <h3 class="text-xs font-semibold text-slate-200 uppercase tracking-wider font-mono mb-4">
          Clinical Knowledge
        </h3>
        <ul class="space-y-2.5 text-sm">
          {Object.values(SECTIONS).map((sec) => (
            <li>
              <a
                href={`/${sec.slug}`}
                class="hover:text-cyan-400 transition-colors flex items-center gap-1.5"
              >
                <span class="text-slate-600">›</span>
                {sec.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Medical Disclaimer Column -->
      <div>
        <h3 class="text-xs font-semibold text-slate-200 uppercase tracking-wider font-mono mb-4">
          Clinical Disclaimer
        </h3>
        <p class="text-xs text-slate-400 leading-relaxed bg-slate-900/60 p-3.5 rounded-xl border border-slate-800/80">
          Resus Docs is intended for qualified healthcare professionals and educational reference only. Clinical decisions must always account for individual patient factors, local institutional protocols, and senior medical consultation.
        </p>
      </div>

    </div>

    <div class="mt-12 pt-6 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>© {new Date().getFullYear()} Resus Docs. Built for Emergency Medicine Practitioners.</p>
      <div class="flex items-center gap-6 font-mono text-[11px]">
        <a href="https://github.com" target="_blank" class="hover:text-cyan-400 transition-colors">GitHub Engine</a>
        <a href="/cesr-portfolio" class="hover:text-cyan-400 transition-colors">CESR Checklist</a>
        <a href="/blog" class="hover:text-cyan-400 transition-colors">FOAMed</a>
      </div>
    </div>
  </div>
</footer>
