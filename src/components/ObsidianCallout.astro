---
interface Props {
  type?: 'note' | 'warning' | 'critical' | 'tip' | 'evidence' | 'algorithm';
  title?: string;
  class?: string;
}

const {
  type = 'note',
  title,
  class: className = '',
} = Astro.props;

const calloutStyles = {
  note: {
    border: 'border-cyan-500/40 bg-cyan-950/20 text-cyan-200',
    titleColor: 'text-cyan-400',
    defaultTitle: 'Clinical Note',
    icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  warning: {
    border: 'border-amber-500/40 bg-amber-950/20 text-amber-200',
    titleColor: 'text-amber-400',
    defaultTitle: 'Clinical Precaution',
    icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
  },
  critical: {
    border: 'border-red-500/50 bg-red-950/30 text-red-200 shadow-glow-red',
    titleColor: 'text-red-400',
    defaultTitle: 'Critical Resus Alert',
    icon: 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  tip: {
    border: 'border-emerald-500/40 bg-emerald-950/20 text-emerald-200',
    titleColor: 'text-emerald-400',
    defaultTitle: 'Clinical Pearl',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  },
  evidence: {
    border: 'border-purple-500/40 bg-purple-950/20 text-purple-200',
    titleColor: 'text-purple-400',
    defaultTitle: 'Evidence Summary',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  algorithm: {
    border: 'border-blue-500/40 bg-blue-950/20 text-blue-200',
    titleColor: 'text-blue-400',
    defaultTitle: 'Step-by-Step Algorithm',
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  },
}[type];
---

<aside class={`my-6 rounded-xl border border-l-4 p-4 sm:p-5 backdrop-blur-md transition-all shadow-md ${calloutStyles.border} ${className}`}>
  <div class="flex items-center gap-2.5 mb-2 font-mono text-sm font-semibold tracking-wide">
    <svg class={`w-5 h-5 flex-shrink-0 ${calloutStyles.titleColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={calloutStyles.icon}></path>
    </svg>
    <span class={calloutStyles.titleColor}>{title || calloutStyles.defaultTitle}</span>
  </div>
  <div class="prose-sm max-w-none text-slate-300 leading-relaxed font-sans">
    <slot />
  </div>
</aside>
