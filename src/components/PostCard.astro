---
import { getSectionConfig } from '../config/sections';

interface Props {
  title: string;
  description: string;
  date: Date;
  section: string;
  slug: string;
  tags?: string[];
  readingTime?: string;
  coverImage?: string;
  featured?: boolean;
}

const {
  title,
  description,
  date,
  section,
  slug,
  tags = [],
  readingTime = '4 min read',
  coverImage,
  featured = false,
} = Astro.props;

const sectionConfig = getSectionConfig(section);
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article
  class={`group relative flex flex-col justify-between rounded-2xl border transition-all duration-300 overflow-hidden ${
    featured
      ? 'bg-gradient-to-br from-white via-slate-50 to-white dark:from-slate-900/90 dark:via-slate-900/60 dark:to-slate-950/90 border-cyan-500/30 dark:border-cyan-500/40 hover:border-cyan-400 shadow-md dark:shadow-glow-cyan/20 p-6 md:p-8'
      : 'bg-white dark:bg-slate-900/50 hover:bg-slate-50/80 dark:hover:bg-slate-900/80 border-slate-200 dark:border-slate-800/80 hover:border-slate-300 dark:hover:border-slate-700 shadow-xs hover:shadow-md p-6'
  }`}
>
  <div>
    <!-- Cover Image if present -->
    {coverImage && (
      <div class="relative w-full h-48 mb-5 overflow-hidden rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800/80">
        <img
          src={coverImage}
          alt={title}
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/10 dark:from-slate-950/80 via-transparent to-transparent"></div>
      </div>
    )}

    <!-- Top Metadata Header -->
    <div class="flex items-center justify-between gap-3 mb-4 text-xs font-mono">
      {sectionConfig && (
        <a
          href={`/${sectionConfig.slug}`}
          class={`inline-flex items-center px-2.5 py-1 rounded-md border text-[11px] font-semibold tracking-wide transition-colors ${sectionConfig.badgeColor}`}
        >
          {sectionConfig.name}
        </a>
      )}
      <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span>•</span>
        <span>{readingTime}</span>
      </div>
    </div>

    <!-- Title & Description -->
    <h3 class={`font-bold tracking-tight text-slate-900 dark:text-slate-100 group-hover:text-cyan-600 dark:group-hover:text-cyan-300 transition-colors mb-2.5 ${featured ? 'text-2xl md:text-3xl' : 'text-lg md:text-xl'}`}>
      <a href={`/${section}/${slug}`} class="focus:outline-none">
        <span class="absolute inset-0 z-10" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed line-clamp-3 mb-6 font-sans">
      {description}
    </p>
  </div>

  <!-- Footer Tags & Arrow CTA -->
  <div class="flex items-center justify-between pt-4 border-t border-slate-200 dark:border-slate-800/60 mt-auto text-xs">
    <div class="flex flex-wrap gap-1.5 z-20">
      {tags.slice(0, 3).map((tag) => (
        <a
          href={`/tags/${tag}`}
          class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800/60 hover:bg-cyan-500/10 dark:hover:bg-cyan-500/20 text-slate-600 dark:text-slate-400 hover:text-cyan-700 dark:hover:text-cyan-300 border border-slate-200 dark:border-slate-700/50 text-[10px] font-mono transition-colors"
        >
          #{tag}
        </a>
      ))}
      {tags.length > 3 && (
        <span class="px-1.5 py-0.5 text-slate-500 dark:text-slate-400 text-[10px] font-mono">+{tags.length - 3}</span>
      )}
    </div>

    <div class="flex items-center gap-1 text-slate-500 dark:text-slate-400 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors font-mono font-medium text-xs">
      <span>Read</span>
      <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </div>
  </div>
</article>
