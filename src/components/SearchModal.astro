---
---

<div id="search-modal-container">
  <!-- Header Trigger Button -->
  <button
    id="search-open-btn"
    type="button"
    class="flex items-center gap-3 px-3.5 py-1.5 rounded-full text-xs font-medium text-slate-400 bg-slate-900/80 hover:bg-slate-800 border border-slate-800 hover:border-cyan-500/40 text-slate-300 transition-all duration-200 shadow-inner group"
  >
    <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-cyan-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <span class="hidden sm:inline">Search clinical docs...</span>
    <span class="sm:hidden">Search</span>
    <kbd class="hidden md:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-mono text-slate-400 bg-slate-950 border border-slate-800 rounded shadow-xs">
      <span class="text-xs">⌘</span>K
    </kbd>
  </button>

  <!-- Modal Overlay -->
  <div
    id="search-backdrop"
    class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center p-4 sm:p-6 md:p-20 overflow-y-auto transition-opacity duration-200 opacity-0"
  >
    <!-- Modal Card -->
    <div
      id="search-modal"
      class="relative w-full max-w-2xl bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh] transform transition-all scale-95"
    >
      <!-- Modal Header -->
      <div class="flex items-center justify-between px-5 py-4 border-b border-slate-800 bg-slate-950/50">
        <div class="flex items-center gap-2.5 text-cyan-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <span class="text-sm font-semibold tracking-wide text-slate-200">Resus Docs Clinical Search</span>
        </div>
        <button
          id="search-close-btn"
          type="button"
          class="p-1 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Pagefind Container -->
      <div class="p-5 overflow-y-auto custom-scrollbar flex-1 min-h-[300px]" id="pagefind-container">
        <!-- Pagefind UI mounts here dynamically -->
        <div id="search" class="w-full"></div>
      </div>

      <!-- Modal Footer -->
      <div class="px-5 py-3 border-t border-slate-800/80 bg-slate-950/80 flex items-center justify-between text-xs text-slate-500 font-mono">
        <div class="flex items-center gap-3">
          <span><kbd class="px-1 py-0.5 bg-slate-900 border border-slate-800 rounded">ESC</kbd> to close</span>
          <span><kbd class="px-1 py-0.5 bg-slate-900 border border-slate-800 rounded">↑</kbd> <kbd class="px-1 py-0.5 bg-slate-900 border border-slate-800 rounded">↓</kbd> navigate</span>
        </div>
        <span class="text-slate-600">Powered by Pagefind</span>
      </div>
    </div>
  </div>
</div>

<script>
  let pagefindUIInitialized = false;

  function loadPagefindCSS() {
    if (document.getElementById('pagefind-css')) return;
    const link = document.createElement('link');
    link.id = 'pagefind-css';
    link.rel = 'stylesheet';
    link.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(link);
  }

  async function initPagefind() {
    if (pagefindUIInitialized) return;
    loadPagefindCSS();
    try {
      // Dynamic import trick to bypass Vite static resolution during build
      const dynamicImport = new Function('path', 'return import(path)');
      const { PagefindUI } = await dynamicImport('/pagefind/pagefind-ui.js');
      new PagefindUI({
        element: '#search',
        showImages: false,
        showSubResults: true,
        resetFilters: false,
        debounceTimeoutMs: 150,
      });
      pagefindUIInitialized = true;
    } catch (e) {
      console.warn('Pagefind static search UI available in production build.');
      const searchContainer = document.getElementById('search');
      if (searchContainer && !pagefindUIInitialized) {
        searchContainer.innerHTML = `
          <div class="p-6 text-center text-slate-400 font-mono text-xs">
            <p class="text-cyan-400 font-semibold mb-2">Dev Mode Active</p>
            <p>Pagefind index is generated automatically during production build (<code>npm run build</code>).</p>
          </div>
        `;
      }
    }
  }

  function setupSearchModal() {
    const openBtn = document.getElementById('search-open-btn');
    const closeBtn = document.getElementById('search-close-btn');
    const backdrop = document.getElementById('search-backdrop');
    const modal = document.getElementById('search-modal');

    if (!openBtn || !closeBtn || !backdrop || !modal) return;

    function openModal() {
      backdrop?.classList.remove('hidden');
      backdrop?.classList.add('flex');
      setTimeout(() => {
        backdrop?.classList.remove('opacity-0');
        modal?.classList.remove('scale-95');
        modal?.classList.add('scale-100');
      }, 10);
      initPagefind();
    }

    function closeModal() {
      backdrop?.classList.add('opacity-0');
      modal?.classList.remove('scale-100');
      modal?.classList.add('scale-95');
      setTimeout(() => {
        backdrop?.classList.add('hidden');
        backdrop?.classList.remove('flex');
      }, 200);
    }

    openBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);

    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (backdrop.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      }
      if (e.key === 'Escape' && !backdrop.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  setupSearchModal();
  document.addEventListener('astro:after-swap', setupSearchModal);
</script>
